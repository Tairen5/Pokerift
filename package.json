{
  "name": "pokerift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Roguelike cooperativo online inspirado en Pokémon Mundo Misterioso (fan project)",
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "start:server": "tsx src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:data": "tsx tools/validate-data.ts",
    "smoke": "tsx tools/smoke.ts",
    "fetch:sprites": "node tools/fetch-spritecollab.mjs",
    "sprite-check": "tsx tools/sprite-check.ts",
    "light-check": "tsx tools/light-check.ts",
    "fx-check": "tsx tools/fx-check.ts",
    "fx-gallery": "node tools/fx-gallery.mjs",
    "import:fx": "node tools/import-pmd-scraper.mjs",
    "import:numbers": "node tools/import-rom-numbers.mjs",
    "import:ui": "node tools/import-rom-ui.mjs",
    "import:town": "node tools/import-rom-town.mjs",
    "import:species": "node tools/import-rom-species.mjs",
    "intro-capture": "tsx tools/intro-capture.ts",
    "ui-check": "tsx tools/ui-check.ts",
    "mobile-check": "tsx tools/mobile-check.ts",
    "gen-preview": "tsx tools/gen-preview.ts",
    "import:dungeons": "node tools/import-rom-dungeons.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.2",
    "concurrently": "^9.2.5",
    "opentype.js": "^1.3.4",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
